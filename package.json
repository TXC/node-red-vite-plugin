{
  "name": "node-red-vite-plugin-mono",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "url": "https://github.com/TXC/node-red-vite-plugin",
    "type": "git"
  },
  "author": {
    "name": "TXC",
    "email": "txc@txc.se"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm run lint && pnpm run format",
    "format": "prettier --check \"packages/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "format:fix": "prettier --write \"packages/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "lint": "eslint --cache \"packages/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "lint:fix": "eslint --cache --fix \"packages/**/*.{js,cjs,mjs,ts,tsx,json}\"",
    "release": "pnpm -r --workspace-concurrency=1 exec semantic-release",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
