  "type": "module",
  "license": "MIT",
  "author": {
    "name": "TXC",
    "email": "txc@txc.se"
  },
  "scripts": {
    "build": "vite build --config ../../vite.config.ts",
    "test": "vitest run",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path ."
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "ts",
    "typescript",
    "tsc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TXC/node-red-vite-plugin.git",
    "directory": "packages/vite-plugin-node-red-node"
  },
  "bugs": {
    "url": "https://github.com/TXC/node-red-vite-plugin/issues"
  },
  "dependencies": {
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "rollup": ">=4",
    "vite": ">=8",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "release": {
    "extends": [
      "semantic-release-monorepo",
      "../../.releaserc.json"
    ]
